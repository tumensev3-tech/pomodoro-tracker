<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Focuslot: timer/focus dial, based on the selected second icon concept. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,25 A29,29 0,1 1,54,83 A29,29 0,1 1,54,25"
        android:strokeWidth="6.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="80"
                android:endX="82"
                android:endY="28">
                <item android:offset="0" android:color="#69B8FF" />
                <item android:offset="0.55" android:color="#4AA8FF" />
                <item android:offset="1" android:color="#6BFFE1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brighter active slot arc. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,25 A29,29 0,0 1,83,54"
        android:strokeWidth="7.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="25"
                android:endX="83"
                android:endY="54">
                <item android:offset="0" android:color="#E7FFF7" />
                <item android:offset="1" android:color="#68F4DC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner focus ring. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,43 A11,11 0,1 1,54,65 A11,11 0,1 1,54,43"
        android:strokeColor="#6A1E76C7"
        android:strokeWidth="3.2" />

    <!-- Four clock/focus markers. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,34 L54,38"
        android:strokeColor="#E8FBFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M70,54 L74,54"
        android:strokeColor="#E8FBFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,70 L54,74"
        android:strokeColor="#E8FBFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M34,54 L38,54"
        android:strokeColor="#E8FBFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Central focus point. -->
    <path android:pathData="M54,48 A6,6 0,1 1,54,60 A6,6 0,1 1,54,48">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="50"
                android:startY="49"
                android:endX="58"
                android:endY="59">
                <item android:offset="0" android:color="#CFFFEF" />
                <item android:offset="1" android:color="#16E5E0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>